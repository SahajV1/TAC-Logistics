# ============================================================================
# Transport Management System — Environment Variables
# Copy this file to ".env.local" and fill in real values.
# Find Supabase keys at: Supabase Dashboard → Project Settings → API.
# ============================================================================

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" / "publishable" key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key — SERVER ONLY. Never expose to the browser.
# Used by the seed script, admin user management, and the cron job.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used in notification emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email notifications (Resend) ------------------------------------------
# Create a free key at https://resend.com → API Keys
RESEND_API_KEY=
# Verified sender, e.g. "TMS Alerts <alerts@yourdomain.com>".
# For quick testing you can use "onboarding@resend.dev".
EMAIL_FROM=TMS Alerts <onboarding@resend.dev>

# ---- Cron protection -------------------------------------------------------
# A random secret. Vercel Cron sends it as a Bearer token; the route rejects
# requests without it. Generate one: `openssl rand -hex 32`.
CRON_SECRET=

# ---- Seed script only (not needed at runtime) ------------------------------
# Default password assigned to every seeded account (change after first login).
SEED_DEFAULT_PASSWORD=Tms@12345
